---
/**
 * Home — / — spec §5.1
 *
 * Composition top to bottom:
 *   hero → lede → featured work × 3 → interlude → index excerpt → footer
 *
 * Featured works are queried from the content collection (headliner: true,
 * sorted by order). View-transition-name is applied to each project name
 * so clicking a headliner triggers the signature title transition (§3
 * motion signature moment #2).
 */
import Base from '~/layouts/Base.astro';
import Reveal from '~/components/Reveal.astro';
import { getCollection } from 'astro:content';

const headliners = (await getCollection('work', (e) => e.data.headliner)).sort(
  (a, b) => a.data.order - b.data.order
);
// Home features the top three headliners; the rest live in /work.
const featured = headliners.slice(0, 3);

const indexedCount = (await getCollection('work')).length - featured.length;

const now = [
  {
    name: 'Zen Technologies',
    when: '2026 –',
    role: 'AI/ML · R&D',
    line: 'Bringing private AI into defense training software — AI that runs on our own hardware, because nothing is allowed to go to the cloud.',
  },
  {
    name: 'Epicure Robotics',
    when: '2024 –',
    role: 'one of two engineers',
    line: 'The software behind robots that make and sell drinks on their own — from the screen a customer taps to the cloud that runs the fleet.',
  },
  {
    name: 'BITS Pilani × Scaler',
    when: '2023 – 2027',
    role: 'B.Sc. (Hons.) CS',
    line: 'Final year. Most of what I know came from shipping alongside it.',
  },
];
---

<Base title="Bhargav.M — Small models, real machines." footerVariant="home">
  {/* ============ HERO ============ */}
  <section class="px-6 pt-28 pb-24 md:px-10 md:pt-44">
    <div class="mx-auto max-w-6xl">
      <p
        data-reveal
        class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-low"
      >
        — portfolio · edition 03 · nov 2026 —
      </p>
      <h1
        data-reveal
        class="mt-8 font-serif italic text-hero text-ink [letter-spacing:-0.035em]"
        style="transition-delay: 80ms"
      >
        Small models,<br />
        real <span class="text-accent">machines.</span>
      </h1>
      <p
        data-reveal
        class="mt-12 max-w-lede text-[16px] leading-[1.6] text-ink-mid md:text-[17px]"
        style="transition-delay: 160ms"
      >
        I build products where AI meets real machines — and I care about how
        they look, feel and reach people as much as how they work. For two
        years I've been one of two engineers behind Epicure Robotics' robots
        that make and sell drinks on their own, open all day with nobody
        behind the counter. Now I'm at Zen Technologies, bringing private AI
        into defense software. On the side, I build small AI models that do
        one job well, cheaply, on hardware you already own.
      </p>
    </div>
  </section>

  {/* ============ NOW ============ */}
  <section class="px-6 pb-32 md:px-10" aria-labelledby="now">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-baseline justify-between border-b border-rule pb-4">
        <h2
          id="now"
          class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-low"
        >
          — now —
        </h2>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-low">
          bangalore · ist
        </span>
      </div>
      <ol>
        {
          now.map((item, i) => (
            <li class="border-b border-rule">
              <Reveal delay={i * 60}>
                <div class="grid gap-3 py-6 md:grid-cols-[260px_1fr] md:gap-10">
                  <div>
                    <p class="font-serif italic text-[26px] leading-none text-ink md:text-[30px]">
                      {item.name}
                    </p>
                    <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.14em] text-ink-low">
                      {item.when} · {item.role}
                    </p>
                  </div>
                  <p class="max-w-2xl text-[15px] leading-[1.6] text-ink-mid md:pt-1">
                    {item.line}
                  </p>
                </div>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ============ FEATURED WORKS ============ */}
  <section class="px-6 pb-8 md:px-10" aria-labelledby="featured">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16 flex items-baseline justify-between border-b border-rule pb-4">
        <h2
          id="featured"
          class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-low"
        >
          — selected work —
        </h2>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-low">
          {featured.length.toString().padStart(2, '0')} shown
        </span>
      </div>
      <ol class="space-y-32 md:space-y-48">
        {
          featured.map((entry, i) => (
            <li>
              <Reveal delay={i * 60}>
                <a
                  href={`/work/${entry.slug}`}
                  class="group block"
                  data-trace="→ read"
                >
                  <div class="flex flex-wrap items-baseline justify-between gap-4">
                    <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">
                      {entry.data.folio}
                    </span>
                    <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-low">
                      {entry.data.year} · {entry.data.role}
                    </span>
                  </div>
                  <h3
                    class="mt-5 font-serif italic text-ink transition-colors group-hover:text-accent text-feat"
                    style={`view-transition-name: project-${entry.slug}; letter-spacing: -0.028em;`}
                  >
                    {entry.data.name}
                  </h3>
                  <p class="mt-6 max-w-xl text-[16px] leading-[1.55] text-ink-mid">
                    {entry.data.tagline}
                  </p>
                  <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-rule pt-4">
                    <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-low">
                      {entry.data.status}
                    </span>
                    <span class="ml-auto font-mono text-[11px] uppercase tracking-[0.14em] text-accent transition-transform group-hover:translate-x-2">
                      → read
                    </span>
                  </div>
                </a>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ============ WHERE I'M HEADED ============ */}
  <section class="px-6 pt-40 md:px-10" aria-labelledby="headed">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 border-b border-rule pb-4">
        <h2
          id="headed"
          class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-low"
        >
          — where I'm headed —
        </h2>
      </div>
      <Reveal>
        <div class="max-w-lede space-y-6 text-[16px] leading-[1.65] text-ink-mid md:text-[17px]">
          <p>
            The best AI today lives in the cloud. A lot of the world can't use
            it — a defense base, a factory floor, a hospital, a robot in a mall
            with bad Wi-Fi. They need AI small enough to run on their own
            machines, and simple enough to trust.
          </p>
          <p>
            I've spent two years putting machines in front of real customers,
            and the last year on AI. I want to build the company that brings
            the two together.
          </p>
          <p>
            I'm not only the engineer in the room. I take ownership of how a
            product looks and feels — the screen a customer taps at an Epicure
            machine, the flows in my own products, this site. And I'm learning
            the other half: putting things in front of people and getting them
            to pay. ChallengeMOB was my first real try — about a thousand
            people joined a paid challenge — and freelance work taught me to
            win clients for my own time.
          </p>
          <p>
            Hardware, payments, AI, design, selling — I pick up whatever the
            problem needs. That's the thing I'm best at.
          </p>
        </div>
      </Reveal>
    </div>
  </section>

  {/* ============ INTERLUDE ============ */}
  <section class="px-6 pt-40 md:px-10">
    <div class="mx-auto max-w-3xl">
      <Reveal>
        <p class="font-serif italic text-[30px] leading-[1.25] text-ink-mid md:text-[40px] md:leading-[1.2]" style="letter-spacing: -0.02em">
          I learn whatever the problem needs, then stay until it ships.
        </p>
      </Reveal>
    </div>
  </section>

  {/* ============ INDEX EXCERPT ============ */}
  <section class="px-6 pt-40 md:px-10">
    <div class="mx-auto flex max-w-6xl items-baseline justify-between border-t border-rule pt-6">
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-low">
        — the rest —
      </span>
      <a
        href="/work"
        class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink hover:text-accent transition-colors"
        data-trace="→ index"
      >
        → {indexedCount} more in /work
      </a>
    </div>
  </section>
</Base>
